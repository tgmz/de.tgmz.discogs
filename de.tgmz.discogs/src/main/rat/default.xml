<rat-config>
	<families>
		<family id='EPL' name="Eclipse Public License" />
	</families>
	<licenses>
		<license family="EPL" id="EPL2.0" name="Eclipse Public 2.0">
			<any id="EPLStandard">
				<spdx name="EPL-2.0" />
			</any>
		</license>
	</licenses>
	<approved>
		<family license_ref="EPL" />
	</approved>
	<matchers>
		<matcher class="org.apache.rat.configuration.builders.AnyBuilder" />
		<matcher class="org.apache.rat.configuration.builders.SpdxBuilder" />
	</matchers>
</rat-config>